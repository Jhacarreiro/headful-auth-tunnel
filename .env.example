# HTTP server
BIND_HOST=127.0.0.1
PORT=19192
BASE_URL=https://example.com

# Persistent browser state
PROFILE_DIR=./profile
TOKEN_FILE=./runtime/token
# AUTH_TOKEN=replace-with-at-least-24-characters

# Browser defaults. All are editable; public defaults stay generic.
SCREEN_WIDTH=1440
SCREEN_HEIGHT=1100
LOCALE=en-US
TIMEZONE_ID=UTC
SCREENSHOT_INTERVAL_MS=2000
NAVIGATION_TIMEOUT_MS=30000

# Public destinations are allowed by default. Private, loopback, link-local,
# reserved and common internal hostnames are blocked.
ALLOW_PRIVATE_NETWORK_NAVIGATION=false
# ALLOWED_HOSTS=auth.internal.example,*.trusted.lan
# DENIED_HOSTS=ads.example.com,*.tracking.example

# Legacy ?token= bootstrap is off because query strings leak into history/logs.
ALLOW_QUERY_TOKEN=false
SESSION_COOKIE_NAME=headful_auth_session

# HTTP hardening
MAX_REQUEST_BYTES=1048576
MAX_TYPE_TEXT_CHARS=16384
MAX_URL_CHARS=8192
SOCKET_TIMEOUT_SECONDS=15
EXPOSE_HEALTH_DETAILS=false
TRUST_FORWARDED_PROTO=false
MAX_DOM_TEXT_CHARS=20000
MAX_DOM_ELEMENTS=250

# Optional TLS. Configure both or neither.
# TLS_CERT=./certs/tunnel.crt
# TLS_KEY=./certs/tunnel.key

# Used by local helper scripts
DISPLAY=:99
